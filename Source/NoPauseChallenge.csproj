<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>$(ModFileName)</RootNamespace>
		<AssemblyName>$(ModFileName)</AssemblyName>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<OutputPath>..\1.7\Assemblies\</OutputPath>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Version>$(ModVersion)</Version>
		<AssemblyVersion>$(ModVersion)</AssemblyVersion>
		<FileVersion>$(ModVersion)</FileVersion>
		<PackageVersion>$(ModVersion)</PackageVersion>
		<InformationalVersion>$(ModVersion)</InformationalVersion>
		<Company>Brrainz</Company>
		<Authors>Andreas Pardeike</Authors>
		<Copyright>Copyright Andreas Pardeike</Copyright>
		<PackageProjectUrl>$(Repository)</PackageProjectUrl>
		<RepositoryUrl>$(Repository)</RepositoryUrl>
		<Product>$(ModName)</Product>
		<PythonCommand Condition="'$(PythonCommand)' == '' And '$(OS)' == 'Windows_NT'">py</PythonCommand>
		<PythonCommand Condition="'$(PythonCommand)' == '' And '$(OS)' != 'Windows_NT'">python3</PythonCommand>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugSymbols>false</DebugSymbols>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DefineConstants>RW12;RW13;TRACE;DEBUG</DefineConstants>
		<Optimize>false</Optimize>
		<DebugType>portable</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="BridgeTools\**\*.cs" />
		<None Include="BridgeTools\**\*" />
		<Content Include="..\1.7\Defs\KeyBindings.xml" Link="KeyBindings.xml" />
		<Content Include="..\Directory.Build.props">
			<Link>%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<!-- Upstream provides only net472. Verify the helper during 1.7 startup. -->
		<PackageReference Include="Brrainz.RimWorld.CrossPromotion" Version="1.1.2" NoWarn="NU1701" />
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5021-unstable" GeneratePathProperty="true" />
		<PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.8" ExcludeAssets="runtime" />
		<PackageReference Include="TaskPubliciser" Version="1.0.3" />
	</ItemGroup>

	<Target Name="MyCode" BeforeTargets="UpdateReferences">
		<PropertyGroup>
			<AssemblyCSharp>$(PkgKrafs_Rimworld_Ref)\ref\net10.0\Assembly-CSharp.dll</AssemblyCSharp>
			<PubliciseOutputPath>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)publicized\</PubliciseOutputPath>
			<AssemblyCSharp_Publicised>$(PubliciseOutputPath)Assembly-CSharp_publicised.dll</AssemblyCSharp_Publicised>
		</PropertyGroup>
		<Message Importance="High" Text="Publicising Rimworld Assembly ..." />
		<MakeDir Directories="$(PubliciseOutputPath)" />
		<Publicise TargetAssemblyPath="$(AssemblyCSharp)" OutputPath="$(PubliciseOutputPath)" Condition="Exists('$(AssemblyCSharp)')" />
		<Message Importance="High" Text="Replacing reference to un-publicised assemblies with publicised equivalents ..." />
		<ItemGroup>
			<Reference Include="$(AssemblyCSharp_Publicised)">
				<SpecificVersion>false</SpecificVersion>
				<HintPath>$(AssemblyCSharp_Publicised)</HintPath>
				<Implicit>true</Implicit>
				<Private>false</Private>
			</Reference>
		</ItemGroup>
	</Target>

	<Target Name="UpdateReferences" AfterTargets="ResolveLockFileReferences">
		<Message Importance="High" Text="Remove References ..." />
		<ItemGroup>
			<Reference Remove="$(PkgKrafs_Rimworld_Ref)\ref\net10.0\Assembly-CSharp.dll" />
		</ItemGroup>
	</Target>

	<Target Name="PostBuildAction" AfterTargets="Build">
		<XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\About\About.xml" Query="//ModMetaData/modVersion/text()">
			<Output TaskParameter="Result" PropertyName="AboutVersion" />
		</XmlPeek>
		<XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\About\Manifest.xml" Query="//Manifest/version/text()">
			<Output TaskParameter="Result" PropertyName="ManifestVersion" />
		</XmlPeek>
		<XmlPoke XmlInputPath="$(MSBuildProjectDirectory)\..\About\About.xml" Query="//ModMetaData/modVersion" Value="$(ModVersion)" Condition="'$(AboutVersion)' != '$(ModVersion)'" />
		<XmlPoke XmlInputPath="$(MSBuildProjectDirectory)\..\About\Manifest.xml" Query="//Manifest/version" Value="$(ModVersion)" Condition="'$(ManifestVersion)' != '$(ModVersion)'" />
	</Target>

	<Target Name="RestoreBridgeTools" BeforeTargets="Build" Condition="'$(BuildBridgeTools)' != 'false' And '$(BridgeToolsRestored)' != 'true' And ('$(RIMWORLD_MOD_DIR)' == '' Or '$(RimworldDeployGuardInner)' == 'true')">
		<Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; restore &quot;$(MSBuildProjectDirectory)\BridgeTools\NoPauseChallenge.BridgeTools.csproj&quot; --nologo --verbosity quiet" />
	</Target>

	<Target Name="BuildBridgeTools" DependsOnTargets="RestoreBridgeTools" AfterTargets="Build" BeforeTargets="_CopyToRimworldUnlocked" Condition="'$(BuildBridgeTools)' != 'false' And ('$(RIMWORLD_MOD_DIR)' == '' Or '$(RimworldDeployGuardInner)' == 'true')">
		<MSBuild
			Projects="$(MSBuildProjectDirectory)\BridgeTools\NoPauseChallenge.BridgeTools.csproj"
			Targets="Build"
			Properties="Configuration=$(Configuration);Platform=$(Platform);NoPauseChallengeAssemblyPath=$(TargetPath)" />
	</Target>

	<Target Name="ValidateRimworldDeployRoot" BeforeTargets="Build" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' != 'true'">
		<Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)\..\scripts\rimworld_deploy_guard.py&quot; validate &quot;$(RIMWORLD_MOD_DIR)&quot; &quot;$(MSBuildProjectFullPath)&quot; &quot;$(ModFileName)&quot;" />
	</Target>

	<Target Name="CopyToRimworld" AfterTargets="PostBuildAction" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' != 'true'">
		<Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)\..\scripts\rimworld_deploy_guard.py&quot; deploy &quot;$(RIMWORLD_MOD_DIR)&quot; &quot;$(MSBuildProjectFullPath)&quot; &quot;$(Configuration)&quot; &quot;$(Platform)&quot; &quot;$(ModFileName)&quot; &quot;$(BuildBridgeTools)&quot;" />
	</Target>

	<Target Name="_CopyToRimworldUnlocked" DependsOnTargets="ValidateLegacyPayload" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' == 'true'">
		<Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)\..\scripts\legacy_payload.py&quot; install &quot;$(NPC_LEGACY_MOD_ROOT)&quot; &quot;$(RIMWORLD_MOD_DIR)\$(ModFileName)&quot;" />
		<PropertyGroup>
			<GlobalBridgeToolsDir>$(RIMWORLD_MOD_DIR)\..\BridgeTools</GlobalBridgeToolsDir>
		</PropertyGroup>
		<ItemGroup>
			<Copy17 Include="..\1.7\**" Exclude="..\1.7\**\*.pdb;..\1.7\**\*.mdb;..\1.7\**\.DS_Store;..\1.7\**\._*;..\1.7\**\*.deps.json" />
			<CopyAbout Include="..\About\About.xml;..\About\Manifest.xml" />
			<CopyLoadFolders Include="..\LoadFolders.xml" />
			<CopyBridgeTools Include="..\artifacts\BridgeTools\NoPauseChallenge\NoPauseChallenge.BridgeTools.dll" Condition="'$(BuildBridgeTools)' != 'false'" />
		</ItemGroup>
		<Copy SourceFiles="@(Copy17)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\1.7\%(RecursiveDir)" />
		<Copy SourceFiles="@(CopyAbout)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)\About\%(RecursiveDir)" />
		<Copy SourceFiles="@(CopyLoadFolders)" DestinationFolder="$(RIMWORLD_MOD_DIR)\$(ModFileName)" />
		<Copy SourceFiles="@(CopyBridgeTools)" DestinationFolder="$(GlobalBridgeToolsDir)\NoPauseChallenge" SkipUnchangedFiles="true" Condition="'@(CopyBridgeTools)' != ''" />
	</Target>

	<Target Name="ValidateLegacyPayload">
		<Error Condition="'$(NPC_LEGACY_MOD_ROOT)' == '' Or !Exists('$(NPC_LEGACY_MOD_ROOT)\1.6\Assemblies\NoPauseChallenge.dll')" Text="Set NPC_LEGACY_MOD_ROOT to the preserved published Steam payload. The repository 1.6 DLL differs." />
	</Target>

	<Target Name="ZipMod" AfterTargets="CopyToRimworld" Condition="'$(RIMWORLD_MOD_DIR)' != ''">
		<Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)\..\scripts\legacy_payload.py&quot; package &quot;$(NPC_LEGACY_MOD_ROOT)&quot; &quot;$(RIMWORLD_MOD_DIR)\$(ModFileName).zip&quot;" />
	</Target>

</Project>
